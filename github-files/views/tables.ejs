<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Database Viewer - BlogDB</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .db-container {
      max-width: 960px;
      margin: 25px auto;
      padding: 0 15px;
    }
    .table-section {
      background: #ffffff;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 30px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }
    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      border-bottom: 2px solid #eef2f5;
      padding-bottom: 10px;
    }
    .table-title {
      font-size: 1.3rem;
      color: #2c3e50;
      margin: 0;
    }
    .badge-count {
      background: #34495e;
      color: white;
      padding: 3px 9px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: bold;
    }
    .table-responsive {
      overflow-x: auto;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }
    .data-table th {
      background: #f8fafc;
      color: #334155;
      font-weight: 700;
      padding: 10px 12px;
      border: 1px solid #e2e8f0;
      white-space: nowrap;
    }
    .data-table td {
      padding: 9px 12px;
      border: 1px solid #e2e8f0;
      color: #334155;
      max-width: 300px;
      word-break: break-word;
    }
    .data-table tr:nth-child(even) {
      background-color: #fbfcfd;
    }
    .data-table tr:hover {
      background-color: #f1f5f9;
    }
    .col-pk {
      color: #e67e22;
      font-weight: bold;
    }
    .col-fk {
      color: #2980b9;
      font-weight: bold;
    }
    .sql-console {
      background: #1e293b;
      color: #f8fafc;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 30px;
    }
    .sql-console h2 {
      margin-top: 0;
      color: #38bdf8;
      font-size: 1.2rem;
    }
    .sql-input {
      width: 100%;
      background: #0f172a;
      border: 1px solid #334155;
      color: #a5f3fc;
      font-family: Consolas, monospace;
      padding: 10px;
      border-radius: 5px;
      font-size: 14px;
      resize: vertical;
      box-sizing: border-box;
    }
    .query-result {
      margin-top: 15px;
      overflow-x: auto;
    }
  </style>
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <a href="/" class="nav-brand">📝 BlogDB</a>
    <div class="nav-links">
      <a href="/" class="btn btn-nav">&larr; Back to Blog Feed</a>
      <% if (user) { %>
        <span class="user-greeting">Signed in as <strong><%= user.name %></strong></span>
        <a href="/signout" class="btn btn-nav">Sign Out 🚪</a>
      <% } else { %>
        <a href="/signin" class="btn btn-nav">Sign In 🔑</a>
      <% } %>
    </div>
  </nav>

  <div class="db-container">
    <header>
      <h1>PostgreSQL Live Database Viewer</h1>
      <p class="subtitle">Direct inspection of tables, schemas, and live rows in <strong>BlogDB</strong></p>
    </header>

    <!-- Table 1: USERS TABLE -->
    <section class="table-section">
      <div class="table-header">
        <h2 class="table-title">👤 Table: <code>users</code></h2>
        <span class="badge-count"><%= users.length %> records</span>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th><span class="col-pk">🔑 user_id</span> <small>(PK, VARCHAR)</small></th>
              <th>name <small>(VARCHAR)</small></th>
              <th>password <small>(MD5 Hash / VARCHAR)</small></th>
            </tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr><td colspan="3" style="text-align: center; color: #888;">No users in table</td></tr>
            <% } else { %>
              <% users.forEach(function(u) { %>
                <tr>
                  <td><strong class="col-pk"><%= u.user_id %></strong></td>
                  <td><%= u.name %></td>
                  <td><code><%= u.password %></code></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Table 2: BLOGS TABLE -->
    <section class="table-section">
      <div class="table-header">
        <h2 class="table-title">📄 Table: <code>blogs</code></h2>
        <span class="badge-count"><%= blogs.length %> records</span>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th><span class="col-pk">🔑 blog_id</span> <small>(PK, SERIAL)</small></th>
              <th>title <small>(VARCHAR)</small></th>
              <th>creator_name <small>(VARCHAR)</small></th>
              <th><span class="col-fk">🔗 creator_user_id</span> <small>(FK, VARCHAR)</small></th>
              <th>body <small>(TEXT)</small></th>
              <th>date_created <small>(TIMESTAMP)</small></th>
            </tr>
          </thead>
          <tbody>
            <% if (blogs.length === 0) { %>
              <tr><td colspan="6" style="text-align: center; color: #888;">No blogs in table</td></tr>
            <% } else { %>
              <% blogs.forEach(function(b) { %>
                <tr>
                  <td><strong class="col-pk">#<%= b.blog_id %></strong></td>
                  <td><strong><%= b.title %></strong></td>
                  <td><%= b.creator_name %></td>
                  <td><span class="col-fk"><%= b.creator_user_id %></span></td>
                  <td><%= b.body %></td>
                  <td><small><%= new Date(b.date_created).toLocaleString() %></small></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive Query Console -->
    <section class="sql-console">
      <h2>⚡ Live SQL Query Console (SELECT only)</h2>
      <form action="/tables" method="GET">
        <textarea name="sql" rows="3" class="sql-input" placeholder="SELECT * FROM blogs ORDER BY blog_id DESC;"><%= typeof customSql !== 'undefined' && customSql ? customSql : '' %></textarea>
        <div style="margin-top: 10px;">
          <button type="submit" class="btn btn-primary">Run Query 🚀</button>
          <a href="/tables" class="btn btn-secondary" style="margin-left: 8px;">Reset</a>
        </div>
      </form>

      <% if (typeof queryError !== 'undefined' && queryError) { %>
        <div style="background: #e11d48; color: white; padding: 10px; border-radius: 4px; margin-top: 15px; font-size: 13px;">
          <strong>SQL Error:</strong> <%= queryError %>
        </div>
      <% } %>

      <% if (typeof queryResult !== 'undefined' && queryResult) { %>
        <div class="query-result">
          <h3 style="color: #38bdf8; font-size: 14px; margin-bottom: 8px;">Query Output (<%= queryResult.rows.length %> rows):</h3>
          <table class="data-table" style="background: white;">
            <thead>
              <tr>
                <% queryResult.fields.forEach(function(f) { %>
                  <th><%= f.name %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% queryResult.rows.forEach(function(row) { %>
                <tr>
                  <% queryResult.fields.forEach(function(f) { %>
                    <td><%= row[f.name] %></td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <footer>
      <p><a href="/" style="color: #2980b9; text-decoration: none;">&larr; Back to Home Feed</a></p>
    </footer>
  </div>

</body>
</html>
